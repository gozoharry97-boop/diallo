# Copie ce fichier en .env.local. Toutes les clés sont facultatives :
# sans elles, l'application tourne avec les prix de référence et sans partage synchronisé.

# Supabase (prix agrégés, listes partagées, vidéos choisies à la main)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude : résumé des recettes importées depuis une vidéo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# YouTube Data API v3 : vidéos de recettes et descriptions des vidéos importées
YOUTUBE_API_KEY=

# Point d'accès oEmbed Instagram (à vérifier au déploiement)
INSTAGRAM_OEMBED_URL=https://graph.facebook.com/v24.0/instagram_oembed

# 1 = l'import vidéo renvoie une recette d'exemple, sans appel à l'IA
IMPORT_DEMO=1

# Identifie Diallo auprès des API publiques (Open Prices le demande)
HTTP_USER_AGENT=Diallo/0.1 (contact@exemple.fr)
